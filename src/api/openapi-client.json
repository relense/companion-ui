              "maximum": 1000,
              "default": 25
            }
          },
          {
            "description": "Page of results to be fetched from the server (1 by default)",
            "name": "page",
            "in": "query",
            "schema": { "type": "number", "minimum": 1, "default": 1 }
          }
        ],
        "tags": ["companions"],
        "responses": {
          "200": {
            "description": "Successfully fetched a list of all Companions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "companionId": { "type": "string" },
                          "name": { "type": "string" },
                          "createdAt": { "type": "string" },
                          "updatedAt": {
                            "type": "string"
                          },
                          "hasOnBoarding": { "type": "boolean" }
                        },
                        "required": [
                          "companionId",
                          "name",
                          "createdAt",
                          "updatedAt",
                          "hasOnBoarding"
                        ]
                      }
                    },
                    "meta": {
                      "type": "object",
                      "description": "Information about the results",
                      "properties": {
                        "pageSize": {
                          "type": "number",
                          "description": "Maximum number of results return in a single request"
                        },
                        "previousPage": {
                          "type": "number",
                          "description": "Number of the previous page. If empty, means the current page is the first one"
                        },
                        "nextPage": {
                          "type": "number",
                          "description": "Number of the next page. If empty, means the current page is the last one"
                        },
                        "pageCount": {
                          "type": "number",
                          "description": "Total number of pages found"
                        },
                        "itemCount": {
                          "type": "number",
                          "description": "Total number of items found"
                        }
                      },
                      "required": ["pageSize", "pageCount", "itemCount"]
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "self": { "type": "string" },
                        "next": { "type": "string" },
                        "prev": { "type": "string" }
                      },
                      "required": ["self"]
                    }
                  },
                  "required": ["items", "meta", "links"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
